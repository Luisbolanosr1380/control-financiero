# ===== Airtable (backend de datos por ahora) =====
# Obtener token: https://airtable.com/create/tokens
# Scopes requeridos: data.records:read, data.records:write
# Base ID: https://airtable.com/api → seleccionar tu base
AIRTABLE_API_KEY=patXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXX

# ===== OpenAI (chat asistente) =====
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXX

# ===== Google Gemini (insights nocturnos) =====
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIzaXXXXXXXXXXXXX

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Cron job security (para insights nocturnos) =====
CRON_SECRET=cambia-este-string-random-en-produccion

# ===== Auth (Clerk) =====
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_XXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_XXXXXXXXXXXXXXX
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Allowlist de correos autorizados (separados por coma) y/o dominio (con o sin "@").
# Si ambos están vacíos, NADIE pasa (fail-closed).
ALLOWED_EMAILS=correo1@ejemplo.com,correo2@ejemplo.com
ALLOWED_DOMAIN=

# ===== Facturación de evaluaciones · Agenda de Golden (solo deploy de Golden) =====
# Llave de FACTURACIÓN (header x-api-key) y secreto del webhook (whsec_fact_…): los entrega Golden,
# van SOLO en el servidor (Vercel). Nunca en código, logs, URLs ni en el navegador. HIT no los tiene.
FACTURACION_API_KEY_AGENDA=
WEBHOOK_SECRET_AGENDA=
# ON (default) escribe de vuelta a la Agenda al facturar/cobrar; OFF = todo en financiero, nada a la Agenda.
# En HIT siempre queda OFF aunque diga ON.
FACTURAR_WRITEBACK=ON
# Monto que se escribe por expediente al facturar: con_iva (como lo registra Golden hoy) | sin_iva
FACTURACION_AGENDA_MONTO=con_iva
# Primera corrida del sync (fecha de ingreso) y, para pruebas, la dirección del doble del API.
FACTURACION_AGENDA_DESDE=2026-01-01
# FACTURACION_AGENDA_URL=https://us-central1-lotesycandidatos.cloudfunctions.net/agendaApi/api/facturacion
